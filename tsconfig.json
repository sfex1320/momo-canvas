{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
,
  "exclude": ["src/core/studio/videoSpec.test.ts", "src/core/studio/h3Bilingual.test.ts", "src/core/services/videoGenBodies.test.ts", "src/core/services/comfyVideoSpec.test.ts", "src/core/studio/projectWorkspace.test.ts", "src/core/studio/projectAssetRouter.test.ts", "src/core/directorIsolation.test.ts", "src/core/studio/specCapability.test.ts", "src/core/scriptIngest.test.ts", "src/core/comfySync/comfySync.test.ts"]
}